<Page x:Class="SLiveTranslator.UI.Pages.TimingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:SLiveTranslator.UI"
      Title="{Binding [Nav.Timing], Source={x:Static l:Loc.Instance}}">
    <Page.Resources>
        <ResourceDictionary Source="PageStyles.xaml"/>
    </Page.Resources>
    <StackPanel Margin="24,12,24,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Style="{StaticResource PageTitle}" Margin="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding [Nav.Subtitles], Source={x:Static l:Loc.Instance}}"/>
            <ui:SymbolIcon Symbol="ChevronRight20" FontSize="18" Margin="10,4,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Style="{StaticResource PageTitle}" Margin="0" Text="{Binding [Nav.Timing], Source={x:Static l:Loc.Instance}}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" FontSize="14" Margin="0,0,0,16" Text="{Binding [Timing.Intro], Source={x:Static l:Loc.Instance}}"/>

        <!-- One sample line, start to finish. -->
        <Border Style="{StaticResource Card}" Padding="20">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Icon="{ui:SymbolIcon Play24}" Command="{Binding PlayCommand}"
                               Content="{Binding [Timing.Play], Source={x:Static l:Loc.Instance}}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="{Binding [Timing.TimelineTitle], Source={x:Static l:Loc.Instance}}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [Timing.TimelineHint], Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                </DockPanel>
                <Border Height="44" CornerRadius="6" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        AutomationProperties.Name="{Binding StayLabel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding FadeInLength}"/>
                            <ColumnDefinition Width="{Binding ShowLength}"/>
                            <ColumnDefinition Width="{Binding StayLength}"/>
                            <ColumnDefinition Width="{Binding FadeOutLength}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#002D6A8C" Offset="0"/>
                                    <GradientStop Color="#FF2D6A8C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Grid.Column="1" Background="#FF2D6A8C">
                            <TextBlock Margin="12,0" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Text="{Binding [Timing.GameShows], Source={x:Static l:Loc.Instance}}"/>
                        </Border>
                        <Border Grid.Column="2" Background="#FF8A6420" BorderThickness="2,0,0,0" BorderBrush="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock Margin="12,0" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding StayLabel}"/>
                        </Border>
                        <Border Grid.Column="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF8A6420" Offset="0"/>
                                    <GradientStop Color="#008A6420" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Margin="0" Text="{Binding TimelineEnd}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0" Text="{Binding TimelineStart}"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- How long the lines stay. -->
        <Border Style="{StaticResource Card}" Padding="20">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="{Binding [Timing.StayTitle], Source={x:Static l:Loc.Instance}}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,12" Text="{Binding [Timing.StayHint], Source={x:Static l:Loc.Instance}}"/>

                <RadioButton GroupName="Stay" IsChecked="{Binding IsFixed}" Content="{Binding [Timing.Fixed], Source={x:Static l:Loc.Instance}}"/>
                <DockPanel Margin="28,4,0,12" IsEnabled="{Binding IsFixed}">
                    <TextBlock DockPanel.Dock="Right" Width="64" Margin="10,0,0,0" Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding StayText}"/>
                    <Slider Minimum="0" Maximum="20" SmallChange="0.5" LargeChange="1" TickFrequency="0.5" IsSnapToTickEnabled="True" MaxWidth="420" HorizontalAlignment="Left"
                            Width="420" Value="{Binding StaySeconds}" AutomationProperties.Name="{Binding [Timing.Fixed], Source={x:Static l:Loc.Instance}}"/>
                </DockPanel>

                <RadioButton GroupName="Stay" IsChecked="{Binding IsByLength}" Content="{Binding [Timing.ByLength], Source={x:Static l:Loc.Instance}}"/>
                <StackPanel Margin="28,4,0,12" IsEnabled="{Binding IsByLength}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="150" Margin="10,0,0,0" Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding ReadingSpeedText}"/>
                        <Slider Minimum="8" Maximum="30" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"
                                Value="{Binding ReadingSpeed}" AutomationProperties.Name="{Binding [Timing.ByLength], Source={x:Static l:Loc.Instance}}"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding ByLengthExample}"/>
                </StackPanel>

                <RadioButton GroupName="Stay" IsChecked="{Binding IsUntilNext}" Content="{Binding [Timing.UntilNext], Source={x:Static l:Loc.Instance}}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,12" Text="{Binding [Timing.UntilNextHint], Source={x:Static l:Loc.Instance}}"/>

                <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,4,0,12"/>

                <TextBlock Style="{StaticResource Body}" Text="{Binding [Timing.Min], Source={x:Static l:Loc.Instance}}"/>
                <DockPanel Margin="0,4,0,2">
                    <TextBlock DockPanel.Dock="Right" Width="64" Margin="10,0,0,0" Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding MinText}"/>
                    <Slider Minimum="0.5" Maximum="5" SmallChange="0.5" LargeChange="1" TickFrequency="0.5" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"
                            Value="{Binding MinSeconds}" AutomationProperties.Name="{Binding [Timing.Min], Source={x:Static l:Loc.Instance}}"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12" Text="{Binding [Timing.MinHint], Source={x:Static l:Loc.Instance}}"/>

                <DockPanel IsEnabled="{Binding IsUntilNext, Converter={StaticResource Not}}">
                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding TimeLeftBar}" AutomationProperties.Name="{Binding [Timing.Bar], Source={x:Static l:Loc.Instance}}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Timing.Bar], Source={x:Static l:Loc.Instance}}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [Timing.BarHint], Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Fades and new lines. -->
        <UniformGrid Columns="2">
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,4,8">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="{Binding [Timing.Fade], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,12" Text="{Binding [Timing.FadeHint], Source={x:Static l:Loc.Instance}}"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding FadeInText}"/>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Timing.FadeIn], Source={x:Static l:Loc.Instance}}"/>
                    </DockPanel>
                    <Slider Margin="0,4,0,12" Minimum="0" Maximum="500" SmallChange="20" LargeChange="100" TickFrequency="20" IsSnapToTickEnabled="True"
                            Value="{Binding FadeInMs}" AutomationProperties.Name="{Binding [Timing.FadeIn], Source={x:Static l:Loc.Instance}}"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding FadeOutText}"/>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Timing.FadeOut], Source={x:Static l:Loc.Instance}}"/>
                    </DockPanel>
                    <Slider Margin="0,4,0,0" Minimum="0" Maximum="2000" SmallChange="50" LargeChange="250" TickFrequency="50" IsSnapToTickEnabled="True"
                            Value="{Binding FadeOutMs}" AutomationProperties.Name="{Binding [Timing.FadeOut], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="4,0,0,8">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,12" Text="{Binding [Timing.NewLine], Source={x:Static l:Loc.Instance}}"/>
                    <RadioButton GroupName="NewLine" IsChecked="{Binding IsPush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding [Timing.Push], Source={x:Static l:Loc.Instance}}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding PushHint}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="NewLine" Margin="0,10,0,0" IsChecked="{Binding IsReplace}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding [Timing.Replace], Source={x:Static l:Loc.Instance}}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding [Timing.ReplaceHint], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- What Clear does. -->
        <Border Style="{StaticResource Card}" Padding="20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,10,0" Text="{Binding [Timing.Clear], Source={x:Static l:Loc.Instance}}"/>
                    <Border Style="{StaticResource Tag}" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                        <TextBlock FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ClearHotkey}"/>
                    </Border>
                </StackPanel>
                <RadioButton GroupName="Clear" IsChecked="{Binding IsClearText}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Timing.ClearText], Source={x:Static l:Loc.Instance}}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [Timing.ClearTextHint], Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Clear" Margin="0,10,0,0" IsChecked="{Binding IsClearStop}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Timing.ClearStop], Source={x:Static l:Loc.Instance}}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [Timing.ClearStopHint], Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                </RadioButton>
                <CheckBox Margin="0,14,0,0" IsChecked="{Binding ClearHistory}" Content="{Binding [Timing.ClearHistory], Source={x:Static l:Loc.Instance}}"/>
            </StackPanel>
        </Border>

        <ui:Button HorizontalAlignment="Right" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetCommand}"
                   Content="{Binding [Timing.Reset], Source={x:Static l:Loc.Instance}}"/>
    </StackPanel>
</Page>
