<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>SLiveTranslator</RootNamespace>
    <AssemblyName>SLiveTranslator</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <InternalsVisibleTo Include="SLiveTranslator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game profiles shipped with the app; GameProfileStore writes them to the data folder on first use. -->
    <EmbeddedResource Include="Assets\Profiles\*.json" LogicalName="SLiveTranslator.Assets.Profiles.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
