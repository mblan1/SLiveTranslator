<Page x:Class="SLiveTranslator.UI.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:SLiveTranslator.UI"
      Title="{Binding [Nav.History], Source={x:Static l:Loc.Instance}}"
      ScrollViewer.CanContentScroll="False">
    <!-- The list scrolls on its own (and virtualizes), so the page itself does not scroll. -->
    <Page.Resources>
        <ResourceDictionary Source="PageStyles.xaml"/>
    </Page.Resources>
    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveCommand}"
                           Content="{Binding [History.Remove], Source={x:Static l:Loc.Instance}}"/>
                <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Broom24}" Command="{Binding ClearCommand}"
                           Content="{Binding [History.Clear], Source={x:Static l:Loc.Instance}}"/>
                <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}"
                           Content="{Binding [History.Refresh], Source={x:Static l:Loc.Instance}}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Margin="0" Text="{Binding [History.Page], Source={x:Static l:Loc.Instance}}"/>
        </DockPanel>
        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{Binding [History.Hint], Source={x:Static l:Loc.Instance}}"/>

        <ui:ListView Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Single"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
            <ui:ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ui:ListView.ItemsPanel>
            <ui:ListView.View>
                <ui:GridView>
                    <GridViewColumn Header="#" Width="50" DisplayMemberBinding="{Binding Index}"/>
                    <GridViewColumn Header="{Binding [History.Source], Source={x:Static l:Loc.Instance}}" Width="280">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" MaxWidth="260" Text="{Binding Source}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{Binding [History.Translation], Source={x:Static l:Loc.Instance}}" Width="280">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" MaxWidth="260" Text="{Binding Translation}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{Binding [History.Provider], Source={x:Static l:Loc.Instance}}" Width="140" DisplayMemberBinding="{Binding Provider}"/>
                </ui:GridView>
            </ui:ListView.View>
        </ui:ListView>
        <TextBlock Grid.Row="2" Style="{StaticResource Hint}" Margin="12,48,12,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                   Text="{Binding [History.Empty], Source={x:Static l:Loc.Instance}}" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}"/>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="{Binding Selected, Converter={StaticResource VisibleWhen}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [History.Fix], Source={x:Static l:Loc.Instance}}"/>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding [History.FixHint], Source={x:Static l:Loc.Instance}}"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,8,0,4" FontStyle="Italic" Text="{Binding Selected.Source}"/>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top" Appearance="Primary" Icon="{ui:SymbolIcon Edit24}"
                               Command="{Binding FixCommand}" Content="{Binding [History.FixButton], Source={x:Static l:Loc.Instance}}"/>
                    <ui:TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Text="{Binding FixText, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
