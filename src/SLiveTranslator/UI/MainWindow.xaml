<ui:FluentWindow x:Class="SLiveTranslator.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:SLiveTranslator.UI"
                 xmlns:pages="clr-namespace:SLiveTranslator.UI.Pages"
                 Title="{Binding [Main.Title], Source={x:Static l:Loc.Instance}}"
                 Width="1060" Height="740" MinWidth="780" MinHeight="540"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="{Binding [Main.Title], Source={x:Static l:Loc.Instance}}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True" OpenPaneLength="240">
            <ui:NavigationView.AutoSuggestBox>
                <ui:AutoSuggestBox x:Name="PageSearch" Icon="{ui:SymbolIcon Search24}"
                                   PlaceholderText="{Binding [Main.Search], Source={x:Static l:Loc.Instance}}"/>
            </ui:NavigationView.AutoSuggestBox>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{Binding [Nav.Home], Source={x:Static l:Loc.Instance}}" Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type pages:HomePage}"/>
                <ui:NavigationViewItem Content="{Binding [Nav.History], Source={x:Static l:Loc.Instance}}" Icon="{ui:SymbolIcon History24}"
                                       TargetPageType="{x:Type pages:HistoryPage}"/>
                <ui:NavigationViewItem Content="{Binding [Nav.Translation], Source={x:Static l:Loc.Instance}}" Icon="{ui:SymbolIcon Translate24}"
                                       TargetPageType="{x:Type pages:TranslationPage}"/>
                <ui:NavigationViewItem Content="{Binding [Nav.Profile], Source={x:Static l:Loc.Instance}}" Icon="{ui:SymbolIcon Games24}"
                                       TargetPageType="{x:Type pages:GameProfilePage}"/>
                <ui:NavigationViewItem x:Name="SubtitlesGroup" Content="{Binding [Nav.Subtitles], Source={x:Static l:Loc.Instance}}"
                                       Icon="{ui:SymbolIcon ClosedCaption24}" IsExpanded="True">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{Binding [Nav.Regions], Source={x:Static l:Loc.Instance}}" Icon="{ui:SymbolIcon SelectObject24}"
                                               TargetPageType="{x:Type pages:RegionsPage}"/>
                        <ui:NavigationViewItem Content="{Binding [Nav.Display], Source={x:Static l:Loc.Instance}}" Icon="{ui:SymbolIcon ShareScreenStart24}"
                                               TargetPageType="{x:Type pages:DisplayPage}"/>
                        <ui:NavigationViewItem Content="{Binding [Nav.Timing], Source={x:Static l:Loc.Instance}}" Icon="{ui:SymbolIcon Timer24}"
                                               TargetPageType="{x:Type pages:TimingPage}"/>
                        <ui:NavigationViewItem Content="{Binding [Nav.Reading], Source={x:Static l:Loc.Instance}}" Icon="{ui:SymbolIcon ScanText24}"
                                               TargetPageType="{x:Type pages:SubtitlesPage}"/>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{Binding [Nav.Overlay], Source={x:Static l:Loc.Instance}}" Icon="{ui:SymbolIcon PaintBrush24}"
                                       TargetPageType="{x:Type pages:OverlayPage}"/>
                <ui:NavigationViewItem Content="{Binding [Nav.Hotkeys], Source={x:Static l:Loc.Instance}}" Icon="{ui:SymbolIcon Keyboard24}"
                                       TargetPageType="{x:Type pages:HotkeysPage}"/>
                <ui:NavigationViewItem Content="{Binding [Nav.Notifications], Source={x:Static l:Loc.Instance}}" Icon="{ui:SymbolIcon Alert24}"
                                       TargetPageType="{x:Type pages:NotificationsPage}"/>
                <ui:NavigationViewItem Content="{Binding [Nav.Storage], Source={x:Static l:Loc.Instance}}" Icon="{ui:SymbolIcon Database24}"
                                       TargetPageType="{x:Type pages:StoragePage}"/>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{Binding [Nav.General], Source={x:Static l:Loc.Instance}}" Icon="{ui:SymbolIcon Info24}"
                                       TargetPageType="{x:Type pages:GeneralPage}"/>
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="Snackbars" VerticalAlignment="Bottom"/>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!-- Unsaved edits: one bar for every page. -->
        <Border Grid.Row="2" Padding="20,10" BorderThickness="0,1,0,0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Visibility="{Binding HasChanges, Converter={x:Static l:VisibleWhen.Instance}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="{Binding [Main.Discard], Source={x:Static l:Loc.Instance}}" Icon="{ui:SymbolIcon ArrowUndo24}"
                               Command="{Binding DiscardCommand}" Margin="0,0,8,0"/>
                    <ui:Button Content="{Binding [Main.Save], Source={x:Static l:Loc.Instance}}" Icon="{ui:SymbolIcon Save24}"
                               Appearance="Primary" Command="{Binding SaveCommand}"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding [Main.Unsaved], Source={x:Static l:Loc.Instance}}"/>
            </DockPanel>
        </Border>

        <pages:WelcomeView Grid.Row="1" Grid.RowSpan="2" DataContext="{Binding Welcome}"
                           Visibility="{Binding IsOpen, Converter={x:Static l:VisibleWhen.Instance}}"/>

        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="3"/>
    </Grid>
</ui:FluentWindow>
