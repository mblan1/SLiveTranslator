<Page x:Class="SLiveTranslator.UI.Pages.GameProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:SLiveTranslator.UI"
      Title="{Binding [Nav.Profile], Source={x:Static l:Loc.Instance}}"
      ScrollViewer.CanContentScroll="False">
    <!-- The grids scroll on their own (and virtualize), so the page itself does not scroll. -->
    <Page.Resources>
        <ResourceDictionary Source="PageStyles.xaml"/>
    </Page.Resources>
    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="{Binding [Profile.Title], Source={x:Static l:Loc.Instance}}"/>

        <ui:CardControl Grid.Row="1" Icon="{ui:SymbolIcon Games24}" Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding [Profile.Use], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Profile.UseHint], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox Width="260" ItemsSource="{Binding UseChoices}" SelectedItem="{Binding SelectedUse}" DisplayMemberPath="Label"/>
        </ui:CardControl>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{Binding [Profile.Edit], Source={x:Static l:Loc.Instance}}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Width="260" HorizontalAlignment="Left" ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding EditTarget}" DisplayMemberPath="Name" IsEnabled="{Binding CanSwitch}"/>
                <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Margin="0,0,6,4" Icon="{ui:SymbolIcon DocumentAdd24}" Command="{Binding NewCommand}"
                               Content="{Binding [Profile.New], Source={x:Static l:Loc.Instance}}"/>
                    <ui:Button Margin="0,0,6,4" Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportCommand}"
                               Content="{Binding [Profile.Import], Source={x:Static l:Loc.Instance}}"/>
                    <ui:Button Margin="0,0,6,4" Icon="{ui:SymbolIcon ArrowExportLtr24}" Command="{Binding ExportCommand}"
                               Content="{Binding [Profile.Export], Source={x:Static l:Loc.Instance}}"/>
                    <ui:Button Margin="0,0,6,4" Icon="{ui:SymbolIcon Broom24}" Command="{Binding ClearProfileCommand}"
                               Content="{Binding [Profile.ClearProfile], Source={x:Static l:Loc.Instance}}"/>
                    <ui:Button Margin="0,0,0,4" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveProfileCommand}"
                               Content="{Binding [Profile.RemoveProfile], Source={x:Static l:Loc.Instance}}"/>
                </WrapPanel>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}"
                           Text="{Binding [Profile.SaveFirst], Source={x:Static l:Loc.Instance}}"
                           Visibility="{Binding IsDirty, Converter={StaticResource VisibleWhen}}"/>
                <TextBlock Grid.Row="3" Margin="0,8,12,0" Style="{StaticResource FieldLabel}" Text="{Binding [Profile.Name], Source={x:Static l:Loc.Instance}}"
                           Visibility="{Binding HasProfile, Converter={StaticResource VisibleWhen}}"/>
                <ui:TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" MaxWidth="520" HorizontalAlignment="Stretch"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding HasProfile, Converter={StaticResource VisibleWhen}}"/>
                <TextBlock Grid.Row="4" Margin="0,8,12,0" Style="{StaticResource FieldLabel}" Text="{Binding [Profile.Processes], Source={x:Static l:Loc.Instance}}"
                           Visibility="{Binding HasProfile, Converter={StaticResource VisibleWhen}}"/>
                <ui:TextBox Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" MaxWidth="520" HorizontalAlignment="Stretch"
                            PlaceholderText="mygame" Text="{Binding ProcessNames, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding HasProfile, Converter={StaticResource VisibleWhen}}"/>
                <StackPanel Grid.Row="3" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="0,12,0,4"
                            Visibility="{Binding HasProfile, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding [Profile.Empty], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Profile.EmptyHint], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource Hint}" Margin="0,0,0,6" Text="{Binding [Profile.GridHint], Source={x:Static l:Loc.Instance}}"
                   Visibility="{Binding HasProfile, Converter={StaticResource VisibleWhen}}"/>

        <TabControl Grid.Row="4" Visibility="{Binding HasProfile, Converter={StaticResource VisibleWhen}}">
            <TabItem Header="{Binding [Profile.Keep], Source={x:Static l:Loc.Instance}}">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Add24}" Command="{Binding Keep.AddCommand}" Content="{Binding [Profile.Add], Source={x:Static l:Loc.Instance}}"/>
                        <ui:Button Icon="{ui:SymbolIcon Delete24}" Command="{Binding Keep.RemoveCommand}" Content="{Binding [Profile.Remove], Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                    <ui:ListView ItemsSource="{Binding Keep.Items}" SelectedItem="{Binding Keep.Selected}" SelectionMode="Single"
                                 VirtualizingPanel.IsVirtualizing="True" PreviewGotKeyboardFocus="OnGridFocus">
                        <ui:ListView.View>
                            <ui:GridView>
                                <GridViewColumn Header="{Binding [Profile.Term], Source={x:Static l:Loc.Instance}}" Width="360">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox MinWidth="320" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </ui:GridView>
                        </ui:ListView.View>
                    </ui:ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="{Binding [Profile.Glossary], Source={x:Static l:Loc.Instance}}">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Add24}" Command="{Binding Glossary.AddCommand}" Content="{Binding [Profile.Add], Source={x:Static l:Loc.Instance}}"/>
                        <ui:Button Icon="{ui:SymbolIcon Delete24}" Command="{Binding Glossary.RemoveCommand}" Content="{Binding [Profile.Remove], Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                    <ui:ListView ItemsSource="{Binding Glossary.Items}" SelectedItem="{Binding Glossary.Selected}" SelectionMode="Single"
                                 VirtualizingPanel.IsVirtualizing="True" PreviewGotKeyboardFocus="OnGridFocus">
                        <ui:ListView.View>
                            <ui:GridView>
                                <GridViewColumn Header="{Binding [Profile.English], Source={x:Static l:Loc.Instance}}" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox MinWidth="180" Text="{Binding En, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{Binding [Profile.Translated], Source={x:Static l:Loc.Instance}}" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox MinWidth="180" Text="{Binding Vi, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{Binding [Profile.Note], Source={x:Static l:Loc.Instance}}" Width="320">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox MinWidth="300" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </ui:GridView>
                        </ui:ListView.View>
                    </ui:ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="{Binding [Profile.Characters], Source={x:Static l:Loc.Instance}}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Add24}" Command="{Binding Characters.AddCommand}" Content="{Binding [Profile.Add], Source={x:Static l:Loc.Instance}}"/>
                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Command="{Binding Characters.RemoveCommand}" Content="{Binding [Profile.Remove], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                        <ui:ListView ItemsSource="{Binding Characters.Items}" SelectedItem="{Binding Characters.Selected}" SelectionMode="Single"
                                     VirtualizingPanel.IsVirtualizing="True" PreviewGotKeyboardFocus="OnGridFocus">
                            <ui:ListView.View>
                                <ui:GridView>
                                    <GridViewColumn Header="{Binding [Profile.CharacterName], Source={x:Static l:Loc.Instance}}" Width="140">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox MinWidth="120" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{Binding [Profile.Gender], Source={x:Static l:Loc.Instance}}" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox MinWidth="80" Text="{Binding Gender, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{Binding [Profile.About], Source={x:Static l:Loc.Instance}}" Width="280">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox MinWidth="260" Text="{Binding About, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </ui:GridView>
                            </ui:ListView.View>
                        </ui:ListView>
                    </DockPanel>
                    <DockPanel Grid.Column="2" DataContext="{Binding Characters.Selected}"
                               Visibility="{Binding Converter={StaticResource VisibleWhen}}">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Text="{Binding [Profile.Address], Source={x:Static l:Loc.Instance}}"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Add24}" Command="{Binding Address.AddCommand}" Content="{Binding [Profile.Add], Source={x:Static l:Loc.Instance}}"/>
                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Command="{Binding Address.RemoveCommand}" Content="{Binding [Profile.Remove], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                        <ui:ListView ItemsSource="{Binding Address.Items}" SelectedItem="{Binding Address.Selected}" SelectionMode="Single"
                                     PreviewGotKeyboardFocus="OnGridFocus">
                            <ui:ListView.View>
                                <ui:GridView>
                                    <GridViewColumn Header="{Binding [Profile.To], Source={x:Static l:Loc.Instance}}" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox MinWidth="110" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{Binding [Profile.Self], Source={x:Static l:Loc.Instance}}" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox MinWidth="60" Text="{Binding Self, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{Binding [Profile.Other], Source={x:Static l:Loc.Instance}}" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox MinWidth="60" Text="{Binding Other, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </ui:GridView>
                            </ui:ListView.View>
                        </ui:ListView>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding [Profile.FixRules], Source={x:Static l:Loc.Instance}}">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Add24}" Command="{Binding FixRules.AddCommand}" Content="{Binding [Profile.Add], Source={x:Static l:Loc.Instance}}"/>
                        <ui:Button Icon="{ui:SymbolIcon Delete24}" Command="{Binding FixRules.RemoveCommand}" Content="{Binding [Profile.Remove], Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                    <ui:ListView ItemsSource="{Binding FixRules.Items}" SelectedItem="{Binding FixRules.Selected}" SelectionMode="Single"
                                 VirtualizingPanel.IsVirtualizing="True" PreviewGotKeyboardFocus="OnGridFocus">
                        <ui:ListView.View>
                            <ui:GridView>
                                <GridViewColumn Header="{Binding [Profile.Trigger], Source={x:Static l:Loc.Instance}}" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox MinWidth="130" Text="{Binding Trigger, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{Binding [Profile.Wrong], Source={x:Static l:Loc.Instance}}" Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox MinWidth="140" Text="{Binding Wrong, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{Binding [Profile.Right], Source={x:Static l:Loc.Instance}}" Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox MinWidth="140" Text="{Binding Right, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{Binding [Profile.Unless], Source={x:Static l:Loc.Instance}}" Width="280">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox MinWidth="260" Text="{Binding Unless, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </ui:GridView>
                        </ui:ListView.View>
                    </ui:ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
