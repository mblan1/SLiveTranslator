<Window x:Class="SLiveTranslator.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SLiveTranslator.UI"
        Title="{Binding [Update.WindowTitle], Source={x:Static l:Loc.Instance}}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="560" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="Segoe UI" FontSize="14" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- A plain window: it can open before the main window ever loaded WPF-UI. Its colours are set in code (dark or light, as the app's theme). -->
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#202020"/>
        <SolidColorBrush x:Key="Card" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="CardEdge" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Text2" Color="#C8C8C8"/>
        <SolidColorBrush x:Key="Accent" Color="#60CDFF"/>
        <SolidColorBrush x:Key="AccentText" Color="#000000"/>
        <SolidColorBrush x:Key="Button" Color="#373737"/>
        <SolidColorBrush x:Key="ButtonEdge" Color="#474747"/>
        <SolidColorBrush x:Key="Track" Color="#454545"/>
        <SolidColorBrush x:Key="ProblemBg" Color="#442726"/>
        <SolidColorBrush x:Key="ProblemEdge" Color="#73403D"/>
        <SolidColorBrush x:Key="Warn" Color="#FF99A4"/>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource Button}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonEdge}"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Background" Value="{DynamicResource Track}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1"
                    VerticalAlignment="Top" Margin="0,2,16,0">
                <Image Source="pack://application:,,,/Assets/app.ico" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding [Update.Title], Source={x:Static l:Loc.Instance}}"/>
                <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0" Text="{Binding Message}"/>
            </StackPanel>
        </Grid>

        <Border Margin="0,18,0,0" Padding="16,12" CornerRadius="6" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,16,2" Text="{Binding [Update.Current], Source={x:Static l:Loc.Instance}}"/>
                <TextBlock Grid.Column="1" Margin="0,2" Text="{Binding CurrentVersion}"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Secondary}" Margin="0,2,16,2" Text="{Binding [Update.New], Source={x:Static l:Loc.Instance}}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2" FontWeight="SemiBold" Text="{Binding NewVersion}"/>
                <TextBlock Grid.Row="2" Style="{StaticResource Secondary}" Margin="0,2,16,2" Text="{Binding [Update.Size], Source={x:Static l:Loc.Instance}}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding SizeText}"/>
                <TextBlock Grid.Row="3" Style="{StaticResource Secondary}" Margin="0,2,16,2" Text="{Binding [Update.Released], Source={x:Static l:Loc.Instance}}"
                           Visibility="{Binding HasReleased, Converter={StaticResource Vis}}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding ReleasedText}" Visibility="{Binding HasReleased, Converter={StaticResource Vis}}"/>
            </Grid>
        </Border>

        <StackPanel Margin="0,16,0,0" Visibility="{Binding HasNotes, Converter={StaticResource Vis}}">
            <TextBlock FontWeight="SemiBold" Text="{Binding [Update.WhatsNew], Source={x:Static l:Loc.Instance}}"/>
            <Border Margin="0,6,0,0" CornerRadius="6" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1">
                <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <TextBlock Style="{StaticResource Secondary}" FontSize="13" LineHeight="20" Text="{Binding Notes}"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource Vis}}">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"/>
            <Grid Margin="0,8,0,0">
                <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Left"/>
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding SpeedText}" HorizontalAlignment="Right" TextWrapping="NoWrap"/>
            </Grid>
        </StackPanel>

        <TextBlock Margin="0,14,0,0" Style="{StaticResource Secondary}" Text="{Binding StatusText}" Visibility="{Binding ShowStatus, Converter={StaticResource Vis}}"/>

        <Border Margin="0,16,0,0" Padding="14,10" CornerRadius="6" Background="{DynamicResource ProblemBg}" BorderBrush="{DynamicResource ProblemEdge}" BorderThickness="1"
                Visibility="{Binding ShowProblem, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Problem}"/>
        </Border>

        <TextBlock Margin="0,16,0,0" Style="{StaticResource Secondary}" FontSize="12.5" Text="{Binding [Update.Kept], Source={x:Static l:Loc.Instance}}"/>

        <Grid Margin="0,18,0,0">
            <Button Style="{StaticResource Link}" HorizontalAlignment="Left" Command="{Binding OpenPageCommand}"
                    Content="{Binding [Update.Page], Source={x:Static l:Loc.Instance}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding QuitCommand}" Content="{Binding [Update.Quit], Source={x:Static l:Loc.Instance}}"/>
                <Button Command="{Binding CancelCommand}" Content="{Binding [Update.Cancel], Source={x:Static l:Loc.Instance}}"
                        Visibility="{Binding Busy, Converter={StaticResource Vis}}"/>
                <Button x:Name="UpdateButton" Style="{StaticResource Primary}" Command="{Binding UpdateCommand}" Content="{Binding UpdateText}" IsDefault="True"
                        Visibility="{Binding CanUpdate, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
