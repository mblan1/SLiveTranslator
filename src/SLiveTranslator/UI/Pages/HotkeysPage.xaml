<Page x:Class="SLiveTranslator.UI.Pages.HotkeysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:SLiveTranslator.UI"
      xmlns:c="clr-namespace:SLiveTranslator.UI.Controls"
      xmlns:pages="clr-namespace:SLiveTranslator.UI.Pages"
      Title="{Binding [Nav.Hotkeys], Source={x:Static l:Loc.Instance}}">
    <Page.Resources>
        <ResourceDictionary Source="PageStyles.xaml"/>
    </Page.Resources>
    <StackPanel Margin="24,12,24,24">
        <DockPanel Margin="0,0,0,16">
            <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetAllCommand}"
                       Content="{Binding [Hotkeys.ResetAll], Source={x:Static l:Loc.Instance}}"/>
            <TextBlock Style="{StaticResource PageTitle}" Margin="0" Text="{Binding [Hotkeys.Title], Source={x:Static l:Loc.Instance}}"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12" Text="{Binding [Hotkeys.Hint], Source={x:Static l:Loc.Instance}}"/>

        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:HotkeyRowViewModel}">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="0" Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Name}"/>
                            <c:HotkeyBox Grid.Column="1" FontFamily="Consolas" Gesture="{Binding Gesture}" IsRecording="{Binding IsRecording}"
                                         PlaceholderText="{Binding [Hotkeys.None], Source={x:Static l:Loc.Instance}}"/>

                            <Grid Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Border Padding="8,2" CornerRadius="4" Background="{DynamicResource SystemFillColorSuccessBrush}"
                                        Visibility="{Binding StateOk, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="{Binding StateText}"/>
                                </Border>
                                <Border Padding="8,2" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                        Visibility="{Binding StateOff, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StateText}"/>
                                </Border>
                                <Border Padding="8,2" CornerRadius="4" Background="{DynamicResource SystemFillColorCautionBrush}"
                                        Visibility="{Binding StateProblem, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="{Binding StateText}"/>
                                </Border>
                            </Grid>

                            <ui:ToggleSwitch Grid.Column="4" Margin="12,0,0,0" IsChecked="{Binding IsEnabled}"/>
                            <ui:Button Grid.Column="5" Margin="12,0,0,0" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetCommand}"
                                       Content="{Binding [Hotkeys.Reset], Source={x:Static l:Loc.Instance}}"/>

                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{Binding Detail}"
                                       Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
