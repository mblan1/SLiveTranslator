<Window x:Class="SLiveTranslator.UI.RegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select subtitle region"
        WindowStyle="None" AllowsTransparency="True" Background="#50000000"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Cursor="Cross"
        WindowStartupLocation="Manual" Left="0" Top="0" Width="320" Height="120"
        KeyDown="OnKeyDown" MouseDown="OnMouseDown" MouseMove="OnMouseMove" MouseUp="OnMouseUp">
    <Canvas x:Name="Root">
        <Border Canvas.Left="24" Canvas.Top="24" Background="#C0101418" CornerRadius="8" Padding="14,10">
            <TextBlock Foreground="White" FontSize="16" FontFamily="Segoe UI"
                       Text="Drag a rectangle around the game's subtitle area. Press Esc to cancel."/>
        </Border>
        <Rectangle x:Name="Selection" Stroke="#FF4FC3F7" StrokeThickness="2" Fill="#304FC3F7" Visibility="Collapsed"/>
    </Canvas>
</Window>
