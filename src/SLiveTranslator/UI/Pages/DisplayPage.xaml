<Page x:Class="SLiveTranslator.UI.Pages.DisplayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:SLiveTranslator.UI"
      Title="{Binding [Nav.Display], Source={x:Static l:Loc.Instance}}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- A small screen with the game's subtitle at the bottom, and the translation above it when Tag is "shown". -->
            <Style x:Key="MiniScreen" TargetType="Border">
                <Setter Property="Height" Value="82"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Background" Value="{StaticResource ScreenSky}"/>
                <Setter Property="ClipToBounds" Value="True"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel Margin="24,12,24,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Style="{StaticResource PageTitle}" Margin="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding [Nav.Subtitles], Source={x:Static l:Loc.Instance}}"/>
            <ui:SymbolIcon Symbol="ChevronRight20" FontSize="18" Margin="10,4,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Style="{StaticResource PageTitle}" Margin="0" Text="{Binding [Nav.Display], Source={x:Static l:Loc.Instance}}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" FontSize="14" Margin="0,0,0,16" Text="{Binding [Display.Intro], Source={x:Static l:Loc.Instance}}"/>

        <UniformGrid Columns="2" Margin="0,0,0,8">
            <RadioButton Style="{StaticResource OptionCard}" GroupName="Mode" Margin="0,0,8,0" IsChecked="{Binding IsPrivate}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="EyeOff24" FontSize="22"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Body}" FontSize="17" FontWeight="SemiBold" Text="{Binding [DisplayMode.Private], Source={x:Static l:Loc.Instance}}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0" Text="{Binding [Display.PrivateTag], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,12" Text="{Binding [Display.PrivateText], Source={x:Static l:Loc.Instance}}"/>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,6,0">
                            <Border Style="{StaticResource MiniScreen}">
                                <Grid>
                                    <Border VerticalAlignment="Bottom" Height="28" Background="{StaticResource ScreenGround}"/>
                                    <Border VerticalAlignment="Top" Margin="16,32,16,0" Height="16" CornerRadius="2" Background="#E6101010">
                                        <Border Margin="10,0" Height="3" Background="White" CornerRadius="1"/>
                                    </Border>
                                    <Border VerticalAlignment="Bottom" Margin="30,0,30,14" Height="3" Background="#BFC6CE" CornerRadius="1"/>
                                </Grid>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding [Display.YourScreen], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0">
                            <Border Style="{StaticResource MiniScreen}">
                                <Grid>
                                    <Border VerticalAlignment="Bottom" Height="28" Background="{StaticResource ScreenGround}"/>
                                    <Border VerticalAlignment="Top" Margin="16,32,16,0" Height="16" CornerRadius="2" BorderThickness="1" BorderBrush="#6A6A6A">
                                        <ui:SymbolIcon Symbol="EyeOff16" FontSize="12" Foreground="#9A9A9A"/>
                                    </Border>
                                    <Border VerticalAlignment="Bottom" Margin="30,0,30,14" Height="3" Background="#BFC6CE" CornerRadius="1"/>
                                </Grid>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding [Display.ViewersPrivate], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource OptionCard}" GroupName="Mode" Margin="8,0,0,0" IsChecked="{Binding IsShared}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="ShareScreenStart24" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Body}" FontSize="17" FontWeight="SemiBold" Text="{Binding [DisplayMode.Shared], Source={x:Static l:Loc.Instance}}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0" Text="{Binding [Display.SharedTag], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,12" Text="{Binding [Display.SharedText], Source={x:Static l:Loc.Instance}}"/>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,6,0">
                            <Border Style="{StaticResource MiniScreen}">
                                <Grid>
                                    <Border VerticalAlignment="Bottom" Height="28" Background="{StaticResource ScreenGround}"/>
                                    <Border VerticalAlignment="Top" Margin="16,32,16,0" Height="16" CornerRadius="2" Background="#E6101010">
                                        <Border Margin="10,0" Height="3" Background="White" CornerRadius="1"/>
                                    </Border>
                                    <Border VerticalAlignment="Bottom" Margin="30,0,30,14" Height="3" Background="#BFC6CE" CornerRadius="1"/>
                                </Grid>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding [Display.YourScreen], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0">
                            <Border Style="{StaticResource MiniScreen}">
                                <Grid>
                                    <Border VerticalAlignment="Bottom" Height="28" Background="{StaticResource ScreenGround}"/>
                                    <Border VerticalAlignment="Top" Margin="16,32,16,0" Height="16" CornerRadius="2" Background="#E6101010">
                                        <Border Margin="10,0" Height="3" Background="White" CornerRadius="1"/>
                                    </Border>
                                    <Border VerticalAlignment="Bottom" Margin="30,0,30,14" Height="3" Background="#BFC6CE" CornerRadius="1"/>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Style="{StaticResource Tag}" Background="#C42B1C">
                                        <TextBlock FontSize="9" FontWeight="Bold" Foreground="White" Text="LIVE"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding [Display.ViewersShared], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </RadioButton>
        </UniformGrid>

        <!-- Shared on screen: what viewers see. -->
        <StackPanel Visibility="{Binding IsShared, Converter={StaticResource VisibleWhen}}">
            <TextBlock Style="{StaticResource SectionTitle}" Margin="0,12,0,8" Text="{Binding [Display.ViewersSee], Source={x:Static l:Loc.Instance}}"/>
            <ui:CardControl Icon="{ui:SymbolIcon ClosedCaption24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Display.ShareSubtitles], Source={x:Static l:Loc.Instance}}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [Display.ShareSubtitlesHint], Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ShareSubtitles}" AutomationProperties.Name="{Binding [Display.ShareSubtitles], Source={x:Static l:Loc.Instance}}"/>
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon History24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Display.ShareHistory], Source={x:Static l:Loc.Instance}}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [Display.ShareHistoryHint], Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ShareHistory}" AutomationProperties.Name="{Binding [Display.ShareHistory], Source={x:Static l:Loc.Instance}}"/>
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon ScanText24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Display.ShareLabels], Source={x:Static l:Loc.Instance}}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [Display.ShareLabelsHint], Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ShareLabels}" AutomationProperties.Name="{Binding [Display.ShareLabels], Source={x:Static l:Loc.Instance}}"/>
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon Alert24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Display.ShareNotices], Source={x:Static l:Loc.Instance}}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [Display.ShareNoticesHint], Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ShareNotices}" AutomationProperties.Name="{Binding [Display.ShareNotices], Source={x:Static l:Loc.Instance}}"/>
            </ui:CardControl>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Icon="{ui:SymbolIcon SelectObject24}" Command="{Binding OpenRegionsCommand}"
                               Content="{Binding [Display.ChangeRegion], Source={x:Static l:Loc.Instance}}"/>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Body}" Text="{Binding PlacementText}"/>
                        <ui:InfoBar Margin="0,6,0,0" IsOpen="True" IsClosable="False" Message="{Binding PlacementStatus}"
                                    Severity="{Binding PlacementKind, Converter={StaticResource SeverityOf}}"/>
                        <ui:InfoBar Margin="0,6,0,0" IsOpen="True" IsClosable="False" Severity="Warning" Message="{Binding MovedNote}"
                                    Visibility="{Binding MovedNote, Converter={StaticResource VisibleWhen}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ui:InfoBar Margin="0,0,0,8" IsOpen="True" IsClosable="False" Severity="Informational"
                        Title="{Binding [Display.WholeScreenTitle], Source={x:Static l:Loc.Instance}}"
                        Message="{Binding [Display.WholeScreen], Source={x:Static l:Loc.Instance}}"/>
        </StackPanel>

        <ui:InfoBar Margin="0,8,0,8" IsOpen="True" IsClosable="False" Severity="Informational"
                    Message="{Binding [Display.PrivateNote], Source={x:Static l:Loc.Instance}}"
                    Visibility="{Binding IsPrivate, Converter={StaticResource VisibleWhen}}"/>

        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,12,0,8" Text="{Binding [Display.More], Source={x:Static l:Loc.Instance}}"/>
        <ui:CardControl Icon="{ui:SymbolIcon WindowShield24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding [Display.HideMain], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Display.HideMainHint], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding HideMainWindow}" AutomationProperties.Name="{Binding [Display.HideMain], Source={x:Static l:Loc.Instance}}"/>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Keyboard24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding [Display.Hotkey], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Display.HotkeyHint], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <TextBlock Style="{StaticResource Body}" FontFamily="Consolas" Text="{Binding ModeHotkey}"/>
        </ui:CardControl>
    </StackPanel>
</Page>
