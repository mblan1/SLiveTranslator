<?xml version="1.0" encoding="utf-8"?>
<!-- One self-contained SLiveTranslator.exe for 64-bit Windows: no .NET install needed. publish.ps1 at the repo root uses it. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- The OCR and capture interop needs its native parts next to the code: they are unpacked on first start. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Not compressed: a compressed bundle unpacks its assemblies into private memory. Measured idle in the tray:
         137 MB compressed (78 MB exe) against 58 MB uncompressed (191 MB exe); memory next to a game matters more. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- ReadyToRun was measured: 126 MB instead of 78 MB, and no faster start or settings window. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <!-- WPF, WinForms and the Windows Runtime projections use reflection: trimming would break them. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
