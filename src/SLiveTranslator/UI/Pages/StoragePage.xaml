<Page x:Class="SLiveTranslator.UI.Pages.StoragePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:SLiveTranslator.UI"
      Title="{Binding [Nav.Storage], Source={x:Static l:Loc.Instance}}"
      ScrollViewer.CanContentScroll="False">
    <!-- The cache list and the log scroll on their own (the list virtualizes), so the page itself does not scroll. -->
    <Page.Resources>
        <ResourceDictionary Source="PageStyles.xaml"/>
    </Page.Resources>
    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="{Binding [Storage.Title], Source={x:Static l:Loc.Instance}}"/>

        <TabControl Grid.Row="1">
            <!-- Data folder -->
            <TabItem Header="{Binding [Storage.FolderTab], Source={x:Static l:Loc.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,8,0">
                    <StackPanel DataContext="{Binding Folder}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenCommand}"
                                                   Content="{Binding [Storage.Open], Source={x:Static l:Loc.Instance}}"/>
                                        <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon FolderArrowRight24}" Command="{Binding ChangeCommand}"
                                                   Content="{Binding [Storage.Change], Source={x:Static l:Loc.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Storage.Folder], Source={x:Static l:Loc.Instance}}"/>
                                        <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Root, Mode=OneWay}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [Storage.ChangeHint], Source={x:Static l:Loc.Instance}}"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Caution}" Margin="0,6,0,0" Text="{Binding NextStart}"
                                           Visibility="{Binding NextStart, Converter={StaticResource VisibleWhen}}"/>
                                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding [Storage.Copying], Source={x:Static l:Loc.Instance}}"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <ui:Button DockPanel.Dock="Right" Margin="10,0,0,0" Command="{Binding CancelCommand}"
                                                   Content="{Binding [Dialog.Cancel], Source={x:Static l:Loc.Instance}}"/>
                                        <ProgressBar Height="6" VerticalAlignment="Center" Maximum="1" Value="{Binding Progress, Mode=OneWay}"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ui:CardControl Icon="{ui:SymbolIcon UsbStick24}" Margin="0,0,0,8" IsEnabled="{Binding CanTogglePortable}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding [Storage.Portable], Source={x:Static l:Loc.Instance}}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding PortableHint}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsPortable}"/>
                        </ui:CardControl>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Storage.Files], Source={x:Static l:Loc.Instance}}"/>
                                <ItemsControl ItemsSource="{Binding Files}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="280"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource Body}" Text="{Binding Name}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding Size}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,6,0,0" Text="{Binding TotalText}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding FreeText}" Visibility="{Binding FreeText, Converter={StaticResource VisibleWhen}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Cache statistics and clearing -->
            <TabItem Header="{Binding [Storage.CacheTab], Source={x:Static l:Loc.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Cache.Stats], Source={x:Static l:Loc.Instance}}"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="320"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Hint}" Text="{Binding [Cache.Provider], Source={x:Static l:Loc.Instance}}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Text="{Binding [Cache.Entries], Source={x:Static l:Loc.Instance}}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Text="{Binding [Cache.EditedCount], Source={x:Static l:Loc.Instance}}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource Hint}" Text="{Binding [Cache.Size], Source={x:Static l:Loc.Instance}}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Stats}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="320"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource Body}" Text="{Binding Provider}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding Entries}"/>
                                                <TextBlock Grid.Column="2" Style="{StaticResource Body}" Text="{Binding Edited}"/>
                                                <TextBlock Grid.Column="3" Style="{StaticResource Body}" Text="{Binding Size}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,6,0,0" Text="{Binding StatsTotal}"/>
                            </StackPanel>
                        </Border>

                        <ui:CardControl Icon="{ui:SymbolIcon Database24}" Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding [Cache.MaxEntries], Source={x:Static l:Loc.Instance}}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Cache.MaxEntriesHint], Source={x:Static l:Loc.Instance}}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:NumberBox Width="170" Minimum="100" Maximum="1000000" SmallChange="1000" LargeChange="10000" MaxDecimalPlaces="0"
                                          Value="{Binding MaxEntries, UpdateSourceTrigger=PropertyChanged}"/>
                        </ui:CardControl>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Cache.ClearTitle], Source={x:Static l:Loc.Instance}}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{Binding [Cache.ClearHint], Source={x:Static l:Loc.Instance}}"/>
                                <WrapPanel>
                                    <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon Broom24}" Command="{Binding ClearOrphansCommand}"
                                               Content="{Binding [Cache.ClearOrphans], Source={x:Static l:Loc.Instance}}"/>
                                    <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon Broom24}" Command="{Binding ClearNonEditedCommand}"
                                               Content="{Binding [Cache.ClearNonEdited], Source={x:Static l:Loc.Instance}}"/>
                                    <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon Delete24}" Command="{Binding ClearAllCommand}"
                                               Content="{Binding [Cache.ClearAll], Source={x:Static l:Loc.Instance}}"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="300" ItemsSource="{Binding ClearProviderChoices}" SelectedItem="{Binding SelectedClearProvider}"
                                              DisplayMemberPath="Label"/>
                                    <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Broom24}" Command="{Binding ClearProviderCommand}"
                                               Content="{Binding [Cache.ClearProvider], Source={x:Static l:Loc.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Cache manager -->
            <TabItem Header="{Binding [Cache.Manager], Source={x:Static l:Loc.Instance}}">
                <DockPanel Margin="0,8,0,0" DataContext="{Binding Manager}">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <ui:TextBox Width="260" Margin="0,0,8,6" Icon="{ui:SymbolIcon Search24}"
                                    PlaceholderText="{Binding [Cache.Search], Source={x:Static l:Loc.Instance}}"
                                    Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>
                        <ComboBox Width="220" Margin="0,0,8,6" ItemsSource="{Binding ProviderChoices}" SelectedItem="{Binding SelectedProvider}"
                                  DisplayMemberPath="Label" ToolTip="{Binding [Cache.Provider], Source={x:Static l:Loc.Instance}}"/>
                        <ComboBox Width="130" Margin="0,0,8,6" ItemsSource="{Binding PairChoices}" SelectedItem="{Binding SelectedPair}"
                                  DisplayMemberPath="Label" ToolTip="{Binding [Cache.Pair], Source={x:Static l:Loc.Instance}}"/>
                        <CheckBox Margin="0,0,8,6" VerticalAlignment="Center" IsChecked="{Binding EditedOnly}"
                                  Content="{Binding [Cache.EditedOnly], Source={x:Static l:Loc.Instance}}"/>
                    </WrapPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Margin="6,0,0,0" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteCommand}"
                                       Content="{Binding [Cache.Delete], Source={x:Static l:Loc.Instance}}"/>
                            <ui:Button Margin="6,0,0,0" Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportCommand}"
                                       Content="{Binding [Cache.Import], Source={x:Static l:Loc.Instance}}"/>
                            <ui:Button Margin="6,0,0,0" Icon="{ui:SymbolIcon ArrowExportLtr24}" Command="{Binding ExportCommand}"
                                       Content="{Binding [Cache.Export], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Body}" Text="{Binding CountText}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding [Cache.EditHint], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                    </DockPanel>
                    <ui:ListView ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Single"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.CanContentScroll="True" PreviewGotKeyboardFocus="OnListFocus">
                        <ui:ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ui:ListView.ItemsPanel>
                        <ui:ListView.View>
                            <ui:GridView>
                                <GridViewColumn Header="{Binding [Cache.Provider], Source={x:Static l:Loc.Instance}}" Width="150" DisplayMemberBinding="{Binding Provider}"/>
                                <GridViewColumn Header="{Binding [Cache.Pair], Source={x:Static l:Loc.Instance}}" Width="76" DisplayMemberBinding="{Binding Pair}"/>
                                <GridViewColumn Header="{Binding [Cache.Source], Source={x:Static l:Loc.Instance}}" Width="210">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Source}" ToolTip="{Binding Source}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{Binding [Cache.Translation], Source={x:Static l:Loc.Instance}}" Width="240">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox MinWidth="220" Text="{Binding Translation}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{Binding [Cache.Edited], Source={x:Static l:Loc.Instance}}" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="✎" Visibility="{Binding Edited, Converter={x:Static l:VisibleWhen.Instance}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{Binding [Cache.Used], Source={x:Static l:Loc.Instance}}" Width="120" DisplayMemberBinding="{Binding Used}"/>
                            </ui:GridView>
                        </ui:ListView.View>
                    </ui:ListView>
                </DockPanel>
            </TabItem>

            <!-- Log -->
            <TabItem Header="{Binding [Logs.Title], Source={x:Static l:Loc.Instance}}">
                <DockPanel Margin="0,8,0,0" DataContext="{Binding Logging}">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,8,6" Text="{Binding [Logs.Level], Source={x:Static l:Loc.Instance}}"/>
                        <ComboBox Width="150" Margin="0,0,16,6" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" DisplayMemberPath="Label"/>
                        <ui:TextBox Width="220" Margin="0,0,8,6" Icon="{ui:SymbolIcon Filter24}"
                                    PlaceholderText="{Binding [Logs.Filter], Source={x:Static l:Loc.Instance}}"
                                    Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=200}"/>
                    </WrapPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}"
                                   Content="{Binding [Logs.Refresh], Source={x:Static l:Loc.Instance}}"/>
                        <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Delete24}" Command="{Binding ClearCommand}"
                                   Content="{Binding [Logs.Clear], Source={x:Static l:Loc.Instance}}"/>
                        <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenFolderCommand}"
                                   Content="{Binding [Logs.OpenFolder], Source={x:Static l:Loc.Instance}}"/>
                        <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyDiagnosticsCommand}"
                                   Content="{Binding [Logs.CopyDiagnostics], Source={x:Static l:Loc.Instance}}"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Text="{Binding [Logs.Hint], Source={x:Static l:Loc.Instance}}"/>
                    <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="{Binding Text, Mode=OneWay}"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
