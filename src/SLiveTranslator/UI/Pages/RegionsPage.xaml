<Page x:Class="SLiveTranslator.UI.Pages.RegionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:SLiveTranslator.UI"
      xmlns:pages="clr-namespace:SLiveTranslator.UI.Pages"
      Title="{Binding [Nav.Regions], Source={x:Static l:Loc.Instance}}">
    <Page.Resources>
        <ResourceDictionary Source="PageStyles.xaml"/>
    </Page.Resources>
    <StackPanel Margin="24,12,24,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Style="{StaticResource PageTitle}" Margin="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding [Nav.Subtitles], Source={x:Static l:Loc.Instance}}"/>
            <ui:SymbolIcon Symbol="ChevronRight20" FontSize="18" Margin="10,4,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Style="{StaticResource PageTitle}" Margin="0" Text="{Binding [Nav.Regions], Source={x:Static l:Loc.Instance}}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" FontSize="14" Margin="0,0,0,16" Text="{Binding [Regions.Intro], Source={x:Static l:Loc.Instance}}"/>

        <!-- The screen with both boxes, and the way to pick them. -->
        <Border Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <Border Width="{x:Static pages:RegionsViewModel.PreviewWidth}" Height="{x:Static pages:RegionsViewModel.PreviewHeight}"
                            Background="{StaticResource ScreenSky}" CornerRadius="6" ClipToBounds="True"
                            AutomationProperties.Name="{Binding [Regions.PreviewName], Source={x:Static l:Loc.Instance}}">
                        <Canvas>
                            <Rectangle Canvas.Left="0" Canvas.Top="160" Width="{x:Static pages:RegionsViewModel.PreviewWidth}" Height="92" Fill="{StaticResource ScreenGround}"/>
                            <Rectangle Canvas.Left="{Binding Preview.Read.Left}" Canvas.Top="{Binding Preview.Read.Top}" Width="{Binding Preview.Read.Width}"
                                       Height="{Binding Preview.Read.Height}" Stroke="{StaticResource ReadBrush}" StrokeThickness="2" Fill="{StaticResource ReadFill}"
                                       Visibility="{Binding Preview.Read, Converter={StaticResource VisibleWhen}}"/>
                            <Rectangle Canvas.Left="{Binding Preview.Show.Left}" Canvas.Top="{Binding Preview.Show.Top}" Width="{Binding Preview.Show.Width}"
                                       Height="{Binding Preview.Show.Height}" Stroke="{StaticResource ShowBrush}" StrokeThickness="2" StrokeDashArray="3 2"
                                       Fill="{StaticResource ShowFill}" Visibility="{Binding Preview.Show, Converter={StaticResource VisibleWhen}}"/>
                        </Canvas>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding Preview.MonitorText}"/>
                    <TextBlock Style="{StaticResource Caution}" Text="{Binding [Regions.NoRegionYet], Source={x:Static l:Loc.Instance}}"
                               Visibility="{Binding HasRegion, Converter={StaticResource VisibleWhen}, ConverterParameter=not}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Regions.PickBoth], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14" Text="{Binding [Regions.PickBothHint], Source={x:Static l:Loc.Instance}}"/>
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon SelectObject24}" Command="{Binding PickBothCommand}"
                               Content="{Binding [Regions.StartPicking], Source={x:Static l:Loc.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Border Width="12" Height="12" BorderThickness="2" BorderBrush="{StaticResource ReadBrush}" CornerRadius="2" Margin="0,0,6,0"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,16,0" Text="{Binding [Regions.LegendRead], Source={x:Static l:Loc.Instance}}"/>
                        <Border Width="12" Height="12" BorderThickness="2" BorderBrush="{StaticResource ShowBrush}" CornerRadius="2" Margin="0,0,6,0"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [Regions.LegendShow], Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Where the app reads. -->
        <Border Style="{StaticResource Card}" Padding="20">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="14" Height="14" BorderThickness="2" BorderBrush="{StaticResource ReadBrush}" Background="{StaticResource ReadFill}"
                            CornerRadius="3" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Margin="0" Text="{Binding RegionText}"/>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="{Binding [Regions.Read], Source={x:Static l:Loc.Instance}}"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,12" Text="{Binding [Subtitles.RegionHint], Source={x:Static l:Loc.Instance}}"/>
                <UniformGrid Columns="4" Margin="0,0,0,12" MaxWidth="620" HorizontalAlignment="Left" IsEnabled="{Binding HasRegion}">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="X"/>
                        <ui:NumberBox Minimum="-20000" Maximum="20000" SmallChange="1" LargeChange="10" MaxDecimalPlaces="0" SpinButtonPlacementMode="Hidden"
                                      Value="{Binding ReadX, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="Y"/>
                        <ui:NumberBox Minimum="-20000" Maximum="20000" SmallChange="1" LargeChange="10" MaxDecimalPlaces="0" SpinButtonPlacementMode="Hidden"
                                      Value="{Binding ReadY, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="{Binding [Regions.Width], Source={x:Static l:Loc.Instance}}"/>
                        <ui:NumberBox Minimum="0" Maximum="20000" SmallChange="1" LargeChange="10" MaxDecimalPlaces="0" SpinButtonPlacementMode="Hidden"
                                      Value="{Binding ReadWidth, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="{Binding [Regions.Height], Source={x:Static l:Loc.Instance}}"/>
                        <ui:NumberBox Minimum="0" Maximum="20000" SmallChange="1" LargeChange="10" MaxDecimalPlaces="0" SpinButtonPlacementMode="Hidden"
                                      Value="{Binding ReadHeight, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </UniformGrid>
                <WrapPanel>
                    <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon SelectObject24}" Command="{Binding PickReadCommand}"
                               Content="{Binding [Regions.SelectOnScreen], Source={x:Static l:Loc.Instance}}"/>
                    <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon ScanText24}" Command="{Binding TestReadingCommand}"
                               Content="{Binding [Regions.TestReading], Source={x:Static l:Loc.Instance}}"/>
                </WrapPanel>
                <ui:InfoBar IsOpen="True" IsClosable="False" Message="{Binding TestText}" Severity="{Binding TestKind, Converter={StaticResource SeverityOf}}"
                            Visibility="{Binding TestText, Converter={StaticResource VisibleWhen}}"/>
            </StackPanel>
        </Border>

        <!-- Where the translation goes, and its box. -->
        <Border Style="{StaticResource Card}" Padding="20">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="14" Height="14" BorderThickness="2" BorderBrush="{StaticResource ShowBrush}" Background="{StaticResource ShowFill}"
                            CornerRadius="3" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="{Binding [Regions.Display], Source={x:Static l:Loc.Instance}}"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,12" Text="{Binding [Regions.DisplayHint], Source={x:Static l:Loc.Instance}}"/>

                <WrapPanel Margin="0,0,0,8">
                    <RadioButton GroupName="Place" Margin="0,0,16,8" IsChecked="{Binding PlaceAbove}">
                        <StackPanel>
                            <Border Width="96" Height="54" Background="{StaticResource ScreenSky}" CornerRadius="3" Margin="0,0,0,4">
                                <Canvas>
                                    <Rectangle Canvas.Left="18" Canvas.Top="36" Width="60" Height="7" Stroke="{StaticResource ReadBrush}" StrokeThickness="1.5"/>
                                    <Rectangle Canvas.Left="18" Canvas.Top="27" Width="60" Height="7" Stroke="{StaticResource ShowBrush}" Fill="{StaticResource ShowFill}" StrokeThickness="1.5" StrokeDashArray="2 1"/>
                                </Canvas>
                            </Border>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding [Region.Preset.AboveRegion], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Place" Margin="0,0,16,8" IsChecked="{Binding PlaceBelow}">
                        <StackPanel>
                            <Border Width="96" Height="54" Background="{StaticResource ScreenSky}" CornerRadius="3" Margin="0,0,0,4">
                                <Canvas>
                                    <Rectangle Canvas.Left="18" Canvas.Top="34" Width="60" Height="7" Stroke="{StaticResource ReadBrush}" StrokeThickness="1.5"/>
                                    <Rectangle Canvas.Left="18" Canvas.Top="43" Width="60" Height="7" Stroke="{StaticResource ShowBrush}" Fill="{StaticResource ShowFill}" StrokeThickness="1.5" StrokeDashArray="2 1"/>
                                </Canvas>
                            </Border>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding [Region.Preset.BelowRegion], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Place" Margin="0,0,16,8" IsChecked="{Binding PlaceBottom}">
                        <StackPanel>
                            <Border Width="96" Height="54" Background="{StaticResource ScreenSky}" CornerRadius="3" Margin="0,0,0,4">
                                <Canvas>
                                    <Rectangle Canvas.Left="18" Canvas.Top="30" Width="60" Height="7" Stroke="{StaticResource ReadBrush}" StrokeThickness="1.5"/>
                                    <Rectangle Canvas.Left="28" Canvas.Top="44" Width="40" Height="6" Stroke="{StaticResource ShowBrush}" Fill="{StaticResource ShowFill}" StrokeThickness="1.5" StrokeDashArray="2 1"/>
                                </Canvas>
                            </Border>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding [Region.Preset.BottomCenter], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Place" Margin="0,0,16,8" IsChecked="{Binding PlaceOver}" IsEnabled="{Binding CanPlaceOver}"
                                 ToolTipService.ShowOnDisabled="True" ToolTip="{Binding [Regions.OverOffShared], Source={x:Static l:Loc.Instance}}">
                        <StackPanel>
                            <Border Width="96" Height="54" Background="{StaticResource ScreenSky}" CornerRadius="3" Margin="0,0,0,4">
                                <Canvas>
                                    <Rectangle Canvas.Left="18" Canvas.Top="36" Width="60" Height="7" Stroke="{StaticResource ReadBrush}" StrokeThickness="1.5"/>
                                    <Rectangle Canvas.Left="18" Canvas.Top="36" Width="60" Height="7" Stroke="{StaticResource ShowBrush}" Fill="{StaticResource ShowFill}" StrokeThickness="1.5" StrokeDashArray="2 1"/>
                                </Canvas>
                            </Border>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding [Region.Preset.OverRegion], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Place" Margin="0,0,16,8" IsChecked="{Binding PlaceCustom}">
                        <StackPanel>
                            <Border Width="96" Height="54" Background="{StaticResource ScreenSky}" CornerRadius="3" Margin="0,0,0,4">
                                <Canvas>
                                    <Rectangle Canvas.Left="18" Canvas.Top="36" Width="60" Height="7" Stroke="{StaticResource ReadBrush}" StrokeThickness="1.5"/>
                                    <Rectangle Canvas.Left="6" Canvas.Top="6" Width="40" Height="9" Stroke="{StaticResource ShowBrush}" Fill="{StaticResource ShowFill}" StrokeThickness="1.5" StrokeDashArray="2 1"/>
                                </Canvas>
                            </Border>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding [Region.Preset.Custom], Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                    </RadioButton>
                </WrapPanel>

                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,12"
                        Visibility="{Binding IsCustom, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <UniformGrid Columns="4" Margin="0,0,0,10" MaxWidth="620" HorizontalAlignment="Left">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="X"/>
                                <ui:NumberBox Minimum="-20000" Maximum="20000" MaxDecimalPlaces="0" SpinButtonPlacementMode="Hidden" Value="{Binding CustomX, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="Y"/>
                                <ui:NumberBox Minimum="-20000" Maximum="20000" MaxDecimalPlaces="0" SpinButtonPlacementMode="Hidden" Value="{Binding CustomY, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="{Binding [Regions.Width], Source={x:Static l:Loc.Instance}}"/>
                                <ui:NumberBox Minimum="0" Maximum="20000" MaxDecimalPlaces="0" SpinButtonPlacementMode="Hidden" Value="{Binding CustomWidth, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="{Binding [Regions.Height], Source={x:Static l:Loc.Instance}}"/>
                                <ui:NumberBox Minimum="0" Maximum="20000" MaxDecimalPlaces="0" SpinButtonPlacementMode="Hidden" Value="{Binding CustomHeight, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>
                        <ui:Button HorizontalAlignment="Left" Icon="{ui:SymbolIcon SelectObject24}" Command="{Binding PickDisplayCommand}"
                                   Content="{Binding [Regions.DrawOnScreen], Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,4,0,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Width="150" Text="{Binding [Regions.Align], Source={x:Static l:Loc.Instance}}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Align" Margin="0,0,12,0" IsChecked="{Binding AlignLeft}" Content="{Binding [Regions.AlignLeft], Source={x:Static l:Loc.Instance}}"/>
                        <RadioButton GroupName="Align" Margin="0,0,12,0" IsChecked="{Binding AlignCenter}" Content="{Binding [Regions.AlignCenter], Source={x:Static l:Loc.Instance}}"/>
                        <RadioButton GroupName="Align" IsChecked="{Binding AlignRight}" Content="{Binding [Regions.AlignRight], Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                </DockPanel>

                <DockPanel Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource FieldLabel}" Width="150" VerticalAlignment="Top" Margin="0,6,12,0"
                               Text="{Binding [Region.Background], Source={x:Static l:Loc.Instance}}"/>
                    <StackPanel>
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource Swatch}" GroupName="Background" Tag="{Binding Hex}" IsChecked="{Binding IsSelected}"
                                                     ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:TextBox Width="130" Margin="6,0,0,0" VerticalAlignment="Center" PlaceholderText="#RRGGBB"
                                        Text="{Binding CustomColorText, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="{Binding [Regions.CustomColor], Source={x:Static l:Loc.Instance}}"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding BackgroundName}"/>
                    </StackPanel>
                </DockPanel>

                <DockPanel Margin="0,6,0,6" IsEnabled="{Binding HasBackground}">
                    <TextBlock Style="{StaticResource FieldLabel}" Width="150" Text="{Binding [Region.Opacity], Source={x:Static l:Loc.Instance}}"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="220" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                VerticalAlignment="Center" Value="{Binding BackgroundOpacity}"
                                AutomationProperties.Name="{Binding [Region.Opacity], Source={x:Static l:Loc.Instance}}"/>
                        <TextBlock Width="48" Margin="10,0,0,0" Style="{StaticResource Body}" Text="{Binding BackgroundOpacity, StringFormat={}{0:0} %}"/>
                    </StackPanel>
                </DockPanel>

                <DockPanel Margin="0,6,0,14">
                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding TextOutline}"
                                     AutomationProperties.Name="{Binding [Region.Outline], Source={x:Static l:Loc.Instance}}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Region.Outline], Source={x:Static l:Loc.Instance}}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [Region.OutlineHint], Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                </DockPanel>

                <ui:InfoBar IsOpen="True" IsClosable="False" Message="{Binding OverlapText}" Severity="{Binding OverlapKind, Converter={StaticResource SeverityOf}}"/>
                <ui:InfoBar Margin="0,8,0,0" IsOpen="True" IsClosable="False" Severity="Warning" Message="{Binding KeptOffText}"
                            Visibility="{Binding KeptOffText, Converter={StaticResource VisibleWhen}}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
