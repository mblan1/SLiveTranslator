<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SLiveTranslator\SLiveTranslator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Witcher 3 profile the app shipped until 2.0: a large real profile for the translation, matching and prompt tests. -->
    <EmbeddedResource Include="Fixtures\witcher3.json" LogicalName="SLiveTranslator.Tests.Fixtures.witcher3.json" />
  </ItemGroup>

</Project>
