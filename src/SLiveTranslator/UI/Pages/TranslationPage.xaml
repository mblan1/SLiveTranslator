<Page x:Class="SLiveTranslator.UI.Pages.TranslationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:SLiveTranslator.UI"
      xmlns:pages="clr-namespace:SLiveTranslator.UI.Pages"
      Title="{Binding [Nav.Translation], Source={x:Static l:Loc.Instance}}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PageStyles.xaml"/>
                <ResourceDictionary Source="ProviderCard.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel Margin="24,12,24,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Translation.Title], Source={x:Static l:Loc.Instance}}"/>

        <ui:CardControl Icon="{ui:SymbolIcon Translate24}" Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding [Translation.Provider], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Translation.ProviderHint], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox Width="300" ItemsSource="{Binding ProviderChoices}" SelectedItem="{Binding SelectedProvider}" DisplayMemberPath="Label"/>
        </ui:CardControl>

        <Border Style="{StaticResource Card}" Visibility="{Binding IsFree, Converter={StaticResource VisibleWhen}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Translation.FreeProvider], Source={x:Static l:Loc.Instance}}"/>
                <TextBlock Style="{StaticResource Body}" Text="{Binding [Translation.FreeAbout], Source={x:Static l:Loc.Instance}}"/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,12,0,0" Text="{Binding [Translation.Cards], Source={x:Static l:Loc.Instance}}"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{Binding [Translation.CardsHint], Source={x:Static l:Loc.Instance}}"/>
        <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:ProviderCardViewModel}">
                    <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Key24}" IsExpanded="{Binding IsExpanded}">
                        <ui:CardExpander.Header>
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Margin="8,0,12,0" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        Visibility="{Binding IsInUse, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                               Text="{Binding [Card.InUse], Source={x:Static l:Loc.Instance}}"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding InfoTitle}"
                                               Visibility="{Binding InfoTitle, Converter={StaticResource VisibleWhen}}"/>
                                </StackPanel>
                            </DockPanel>
                        </ui:CardExpander.Header>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProviderCardBody}" Focusable="False"/>
                    </ui:CardExpander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,12,0,8" Text="{Binding [Translation.ContextTitle], Source={x:Static l:Loc.Instance}}"/>
        <ui:CardControl Icon="{ui:SymbolIcon History24}" Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding [Translation.UseContext], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Translation.UseContextHint], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding UseContext}"/>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon TextFont24}" Margin="0,0,0,8" IsEnabled="{Binding UseContext}">
            <ui:CardControl.Header>
                <TextBlock Style="{StaticResource Body}" Text="{Binding [Translation.ContextLines], Source={x:Static l:Loc.Instance}}"/>
            </ui:CardControl.Header>
            <ui:NumberBox Width="140" Minimum="2" Maximum="10" SmallChange="1" MaxDecimalPlaces="0"
                          Value="{Binding ContextLines, UpdateSourceTrigger=PropertyChanged}"/>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Person24}" Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding [Translation.Email], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Translation.EmailHint], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox Width="280" PlaceholderText="name@example.com" Text="{Binding MyMemoryEmail, UpdateSourceTrigger=PropertyChanged}"/>
        </ui:CardControl>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Translation.TestTitle], Source={x:Static l:Loc.Instance}}"/>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding [Translation.TestHint], Source={x:Static l:Loc.Instance}}"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,8" FontStyle="Italic" Text="{x:Static pages:TranslationViewModel.SampleLine}"/>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon Play24}" Command="{Binding TestCommand}"
                               Content="{Binding [Translation.Test], Source={x:Static l:Loc.Instance}}"/>
                    <ui:ProgressRing Width="22" Height="22" Margin="10,0,0,0" IsIndeterminate="True"
                                     Visibility="{Binding Testing, Converter={StaticResource VisibleWhen}}"/>
                </StackPanel>
                <TextBox Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                         Text="{Binding TestResult, Mode=OneWay}" Visibility="{Binding TestResult, Converter={StaticResource VisibleWhen}}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
