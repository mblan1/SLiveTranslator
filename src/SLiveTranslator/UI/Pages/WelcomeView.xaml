<UserControl x:Class="SLiveTranslator.UI.Pages.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:SLiveTranslator.UI"
             xmlns:pages="clr-namespace:SLiveTranslator.UI.Pages">
    <!-- The first-run wizard: over the pages and the Save bar, below the title bar, so the window can still be moved and closed. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PageStyles.xaml"/>
                <ResourceDictionary Source="ProviderCard.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,24,48,24" MaxWidth="820">
                <TextBlock Style="{StaticResource Hint}" Text="{Binding StepText}"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Welcome.Title], Source={x:Static l:Loc.Instance}}"/>

                <!-- 1: language -->
                <StackPanel Visibility="{Binding OnLanguage, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Welcome.LanguageTitle], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12" Text="{Binding [Welcome.LanguageText], Source={x:Static l:Loc.Instance}}"/>
                    <ComboBox Width="260" HorizontalAlignment="Left" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="Label"/>
                </StackPanel>

                <!-- 2: translation service, with the Translation page's card -->
                <StackPanel Visibility="{Binding OnProvider, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Welcome.ProviderTitle], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12" Text="{Binding [Welcome.ProviderText], Source={x:Static l:Loc.Instance}}"/>
                    <ComboBox Width="320" HorizontalAlignment="Left" Margin="0,0,0,12" ItemsSource="{Binding Translation.ProviderChoices}"
                              SelectedItem="{Binding Translation.SelectedProvider}" DisplayMemberPath="Label"/>
                    <Border Style="{StaticResource Card}" Visibility="{Binding Translation.IsFree, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Translation.FreeAbout], Source={x:Static l:Loc.Instance}}"/>
                    </Border>
                    <Border Style="{StaticResource Card}" Visibility="{Binding Translation.IsFree, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                        <ContentControl Content="{Binding Translation.SelectedCard}" ContentTemplate="{StaticResource ProviderCardBody}" Focusable="False"/>
                    </Border>
                </StackPanel>

                <!-- 3: subtitle region -->
                <StackPanel Visibility="{Binding OnRegion, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Welcome.RegionTitle], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12" Text="{Binding [Welcome.RegionText], Source={x:Static l:Loc.Instance}}"/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Appearance="Primary" Icon="{ui:SymbolIcon SelectObject24}"
                                       Command="{Binding Subtitles.SelectRegionCommand}" Content="{Binding [Subtitles.Select], Source={x:Static l:Loc.Instance}}"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [Subtitles.Region], Source={x:Static l:Loc.Instance}}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding Subtitles.RegionText}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding [Subtitles.RegionHint], Source={x:Static l:Loc.Instance}}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- 4: try the hotkeys -->
                <StackPanel Visibility="{Binding OnHotkeys, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Welcome.HotkeysTitle], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12" Text="{Binding [Welcome.HotkeysText], Source={x:Static l:Loc.Instance}}"/>
                    <ItemsControl ItemsSource="{Binding Hotkeys}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pages:TrialHotkey}">
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource Body}" Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Body}" FontFamily="Consolas" FontSize="15" Text="{Binding Gesture}"/>
                                        <Border Grid.Column="2" Padding="10,2" CornerRadius="4" Background="{DynamicResource SystemFillColorSuccessBrush}"
                                                Visibility="{Binding Pressed, Converter={StaticResource VisibleWhen}}">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                       Text="{Binding [Welcome.Works], Source={x:Static l:Loc.Instance}}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center"
                                                   Text="{Binding [Welcome.PressIt], Source={x:Static l:Loc.Instance}}"
                                                   Visibility="{Binding Pressed, Converter={StaticResource VisibleWhen}, ConverterParameter=not}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{Binding [Welcome.HotkeysLater], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="20,10" BorderThickness="0,1,0,0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding BackCommand}"
                               Content="{Binding [Welcome.Back], Source={x:Static l:Loc.Instance}}"/>
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowRight24}" Command="{Binding NextCommand}"
                               Content="{Binding [Welcome.Next], Source={x:Static l:Loc.Instance}}"
                               Visibility="{Binding IsLast, Converter={StaticResource VisibleWhen}, ConverterParameter=not}"/>
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding FinishCommand}"
                               Content="{Binding [Welcome.Finish], Source={x:Static l:Loc.Instance}}"
                               Visibility="{Binding IsLast, Converter={StaticResource VisibleWhen}}"/>
                </StackPanel>
                <ui:Button HorizontalAlignment="Left" Appearance="Transparent" Command="{Binding FinishCommand}"
                           Content="{Binding [Welcome.Skip], Source={x:Static l:Loc.Instance}}"
                           Visibility="{Binding IsLast, Converter={StaticResource VisibleWhen}, ConverterParameter=not}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
