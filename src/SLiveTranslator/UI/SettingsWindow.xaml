<Window x:Class="SLiveTranslator.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SLiveTranslator settings" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Game text language (OCR)"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="OcrLang"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Translate into"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TargetLang" IsEditable="True"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Translation service"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Provider">
            <ComboBoxItem Content="Free: Google, MyMemory as backup (no key)"/>
            <ComboBoxItem Content="Claude API (best quality, needs API key)"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="MyMemory email (optional)"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="MyMemoryEmail"
                 ToolTip="Raises the MyMemory free limit from 5,000 to 50,000 characters per day."/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Claude API key"/>
        <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="ClaudeKey"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Claude model"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="ClaudeModel"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Subtitle region"/>
        <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,4">
            <Button DockPanel.Dock="Right" Content="Select…" Padding="12,3" Click="OnSelectRegion"/>
            <TextBlock x:Name="RegionText" Text="not set"/>
        </DockPanel>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Subtitle check interval (ms)"/>
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="Interval"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Subtitle font size"/>
        <TextBox Grid.Row="8" Grid.Column="1" x:Name="FontSizeBox"/>

        <TextBlock Grid.Row="9" Grid.Column="0" Text="Screen labels auto-hide (seconds)"/>
        <TextBox Grid.Row="9" Grid.Column="1" x:Name="OverlaySeconds"/>

        <TextBlock Grid.Row="10" Grid.Column="0" Text="Hotkey: translate screen"/>
        <TextBox Grid.Row="10" Grid.Column="1" x:Name="HkScreen"/>

        <TextBlock Grid.Row="11" Grid.Column="0" Text="Hotkey: subtitles on/off"/>
        <TextBox Grid.Row="11" Grid.Column="1" x:Name="HkSubtitles"/>

        <TextBlock Grid.Row="12" Grid.Column="0" Text="Hotkey: select subtitle region"/>
        <TextBox Grid.Row="12" Grid.Column="1" x:Name="HkRegion"/>

        <TextBlock Grid.Row="13" Grid.Column="0" Text="Hotkey: clear overlay"/>
        <TextBox Grid.Row="13" Grid.Column="1" x:Name="HkClear"/>

        <TextBlock Grid.Row="14" Grid.Column="0" Text="Hotkey: dialog history"/>
        <TextBox Grid.Row="14" Grid.Column="1" x:Name="HkHistory"/>

        <TextBlock Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#666"
                   Text="Subtitle region: select only the strip where subtitles appear, not the whole screen. For menus and items use the translate-screen hotkey. OCR languages come from Windows: Settings › Time &amp; Language › Language &amp; region › Add a language. Run the game in borderless/windowed mode."/>

        <StackPanel Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Save" Width="90" Padding="0,4" IsDefault="True" Click="OnSave" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="90" Padding="0,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
