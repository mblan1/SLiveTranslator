<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>SLiveTranslator</RootNamespace>
    <AssemblyName>SLiveTranslator</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <!-- WFO0003 asks WinForms apps to set DPI awareness in code instead of the manifest. This is a WPF app: the
         manifest is what makes the process per-monitor aware before WPF starts, which the overlays' pixel layout needs. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <InternalsVisibleTo Include="SLiveTranslator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game profiles shipped with the app; GameProfileStore writes them to the data folder on first use. -->
    <EmbeddedResource Include="Assets\Profiles\*.json" LogicalName="SLiveTranslator.Assets.Profiles.%(Filename)%(Extension)" />
    <!-- The UI texts per language, read by UI/Loc.cs. -->
    <EmbeddedResource Include="Assets\Strings\*.json" LogicalName="SLiveTranslator.Assets.Strings.%(Filename)%(Extension)" />
    <!-- The app icon (made by tools/IconGen) for the tray and the title bar; the exe carries it as ApplicationIcon. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
