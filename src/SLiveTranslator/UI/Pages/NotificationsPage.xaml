<Page x:Class="SLiveTranslator.UI.Pages.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:SLiveTranslator.UI"
      xmlns:pages="clr-namespace:SLiveTranslator.UI.Pages"
      Title="{Binding [Nav.Notifications], Source={x:Static l:Loc.Instance}}">
    <Page.Resources>
        <ResourceDictionary Source="PageStyles.xaml"/>
    </Page.Resources>
    <StackPanel Margin="24,12,24,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Notifications.Title], Source={x:Static l:Loc.Instance}}"/>

        <ui:CardControl Icon="{ui:SymbolIcon AlertOn24}" Margin="0,0,0,16">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding [Notifications.Test], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Notifications.TestHint], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Command="{Binding TestCommand}"
                       Content="{Binding [Notifications.TestButton], Source={x:Static l:Loc.Instance}}"/>
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Notifications.Kinds], Source={x:Static l:Loc.Instance}}"/>
        <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:NoticeCategoryRow}">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Name}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding Hint}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Margin="16,0,8,0"
                                       Text="{Binding [Notifications.Seconds], Source={x:Static l:Loc.Instance}}"/>
                            <ui:NumberBox Grid.Column="2" Width="130" Minimum="1" Maximum="30" SmallChange="0.5" LargeChange="5" MaxDecimalPlaces="1"
                                          IsEnabled="{Binding Enabled}" Value="{Binding Seconds, UpdateSourceTrigger=PropertyChanged}"/>
                            <ui:ToggleSwitch Grid.Column="3" Margin="16,0,0,0" IsChecked="{Binding Enabled}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,12,0,8" Text="{Binding [Notifications.Where], Source={x:Static l:Loc.Instance}}"/>
        <ui:CardControl Icon="{ui:SymbolIcon WindowText20}" Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding [Notifications.Position], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Notifications.PositionHint], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox Width="220" ItemsSource="{Binding Positions}" SelectedItem="{Binding SelectedPosition}" DisplayMemberPath="Label"/>
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon Speaker224}" Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding [Notifications.Sound], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Notifications.SoundHint], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding Sound}"/>
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon ChatBubblesQuestion24}" Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding [Notifications.Balloons], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Notifications.BalloonsHint], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding TrayBalloons}"/>
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon RecordStop24}" Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding [Notifications.Badge], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Notifications.BadgeHint], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding LiveBadge}"/>
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon AlertOff24}" Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding [Notifications.Mute], Source={x:Static l:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Notifications.MuteHint], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding Muted}"/>
        </ui:CardControl>
    </StackPanel>
</Page>
